---
import { bild, gerichtBild, srcset, fallbackSrc, type BildInfo } from '../../lib/bilder';
import { gerichtNr, speisekarte } from '../../data/speisekarte';

/**
 * „Teller auf dem Tisch“: freigestellte Schüsseln (`teller-<nr>-<name>.*`, transparenter Hintergrund)
 * stehen frei auf dem dunklen Grund und werfen einen Schatten. Erzeugt mit scripts/teller-freistellen.mjs,
 * siehe BILDER.md. Ohne freigestellte Datei bleibt der Platz leer – ein rund maskiertes Foto wäre keine Alternative.
 * Ein eigenes Lehmofen-Foto (`tandoor.*`) ersetzt automatisch den großen Teller und läuft dann weich aus.
 */
const tellerBild = (nr: number) => {
  const g = gerichtBild(nr);
  return g ? bild(g.basis.replace(/^gericht-/, 'teller-')) : undefined;
};
const tandoorBild = bild('tandoor');
const teller: { bild?: BildInfo; text: string; nr?: number; groesse: 'gross' | 'mittel' | 'klein'; szene?: boolean }[] = [
  tandoorBild
    ? { bild: tandoorBild, text: 'Unser Holzkohle-Lehmofen aus Indien', groesse: 'gross', szene: true }
    : { bild: tellerBild(116), nr: 116, text: gerichtNr(116).name, groesse: 'gross' },
  { bild: tellerBild(66), nr: 66, text: gerichtNr(66).name, groesse: 'mittel' },
  { bild: tellerBild(89), nr: 89, text: gerichtNr(89).name, groesse: 'klein' },
].filter((t) => t.bild);

const vegKategorie = speisekarte.find((k) => k.id === 'vegetarisch')!;
const anzahlVeg = vegKategorie.gerichte.length;
const anzahlVegan = speisekarte.flatMap((k) => k.gerichte).filter((g) => g.veganMoeglich).length;

const punkte = [
  {
    titel: 'Der Lehmofen',
    text: 'Unser Tandoor ist ein original Holzkohle-Lehmofen aus Indien. Darin garen Tikka, Tandoori Chicken und Riesengarnelen über der Glut – und darin backen wir unsere Brote frisch.',
  },
  {
    titel: 'Paneer aus eigener Küche',
    text: 'Den Käse für Palak Paneer, Shahi Paneer, Paneer Butter Masala oder Malai Kofta machen wir selbst – auch Brote wie das Paneer Kulcha werden damit gefüllt.',
  },
  {
    titel: 'Thalis auf indischen Platten',
    text: 'Die Spezialität unseres Chefkochs: mehrere Gerichte, Raita, Salat, Pappad und Basmati-Reis aus Nordindien, serviert auf original indischen Platten.',
  },
  {
    titel: 'Vegetarisch mit Auswahl',
    text: `${anzahlVeg} vegetarische Hauptgerichte, dazu Vorspeisen, Brote und Biryani ohne Fleisch. ${anzahlVegan} Gerichte bekommen Sie auch vegan.`,
  },
];

const sizes = { gross: '(min-width: 64rem) 34rem, 92vw', mittel: '(min-width: 64rem) 20rem, 52vw', klein: '(min-width: 64rem) 15rem, 40vw' };
---

<section id="haus" class="besonderes koernung relative overflow-hidden bg-tinte pb-28 pt-20 md:pb-36 md:pt-28" aria-labelledby="haus-titel">
  <div class="rahmen">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-6 lg:row-start-1">
        <h2 id="haus-titel" class="display-l text-creme">Was man bei uns schmeckt.</h2>
      <span class="goldfaden" aria-hidden="true"></span>
        <p class="mt-6 max-w-[30rem] text-lead leading-relaxed text-rauch" data-erscheinen>
          Holzkohleglut, Joghurtmarinade, Safran und Ingwer. Bei Bombay kommt das Feuer aus einem echten Lehmofen und
          der Käse aus der eigenen Küche.
        </p>

        <ol class="punkte mt-10" role="list">
          {
            punkte.map((p, i) => (
              <li class="punkt" data-erscheinen style={`--verzoegerung:${i}`}>
                <h3 class="display-m text-creme">{p.titel}</h3>
                <p class="mt-2.5 text-basis leading-relaxed text-rauch">{p.text}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- Teller-Komposition -->
      <div class="tafel lg:col-span-6 lg:col-start-7 lg:row-start-1" aria-label="Gerichte aus unserer Küche">
        {
          teller.map((t, i) => (
            <figure class:list={['teller', `teller--${t.groesse}`]} data-parallax={['0.05', '0.12', '0.18'][i]}>
              <div class:list={['teller-bild', { 'teller-bild--szene': t.szene }]} data-erscheinen style={`--verzoegerung:${i + 1}`}>
                <picture>
                  <source type="image/avif" srcset={srcset(t.bild!, 'avif')} sizes={sizes[t.groesse]} />
                  <source type="image/webp" srcset={srcset(t.bild!, 'webp')} sizes={sizes[t.groesse]} />
                  <img src={fallbackSrc(t.bild!)} alt={t.text} loading="lazy" decoding="async" width={t.bild!.breite} height={t.bild!.hoehe} />
                </picture>
              </div>
              <figcaption class="teller-text">
                {t.nr && <span class="tabellenziffern text-safran">Nr. {t.nr}</span>} {t.text}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .punkt {
    position: relative;
    padding: 1.4rem 0 1.5rem 2.6rem;
    border-top: 1px solid color-mix(in oklab, var(--color-creme) 10%, transparent);
  }
  .punkt::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.85rem;
    width: 1.35rem;
    height: 1.35rem;
    background: var(--color-safran);
    -webkit-mask: url('/ornament/kachel.svg') no-repeat center / 205%;
    mask: url('/ornament/kachel.svg') no-repeat center / 205%;
  }
  .punkt:nth-child(2)::before {
    background: var(--color-rani-hell);
  }
  .punkt:nth-child(4)::before {
    background: var(--color-kardamom-hell);
  }

  /* Teller: freigestellte Schüsseln mit Kontaktschatten, darunter ein warmer Lichtschein wie von der Glut */
  .tafel {
    position: relative;
    min-height: 30rem;
  }
  .tafel::before {
    content: '';
    position: absolute;
    inset: -8% -14% -6% -10%;
    background:
      radial-gradient(44% 38% at 62% 32%, color-mix(in oklab, var(--color-glut) 30%, transparent), transparent 72%),
      radial-gradient(30% 26% at 28% 70%, color-mix(in oklab, var(--color-kurkuma) 14%, transparent), transparent 70%);
    pointer-events: none;
  }
  .teller {
    position: absolute;
    margin: 0;
  }
  .teller-bild img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 1.1rem 1.6rem color-mix(in oklab, var(--color-russ) 85%, transparent))
      drop-shadow(0 0.25rem 0.35rem color-mix(in oklab, var(--color-russ) 70%, transparent));
  }
  .teller-bild--szene {
    aspect-ratio: 4 / 5;
    -webkit-mask:
      linear-gradient(to right, transparent, #000 14%, #000 86%, transparent),
      linear-gradient(to bottom, transparent, #000 12%, #000 80%, transparent);
    -webkit-mask-composite: source-in;
    mask:
      linear-gradient(to right, transparent, #000 14%, #000 86%, transparent),
      linear-gradient(to bottom, transparent, #000 12%, #000 80%, transparent);
    mask-composite: intersect;
  }
  .teller-bild--szene img {
    height: 100%;
    object-fit: cover;
    filter: none;
  }
  .teller-text {
    display: block;
    margin-top: 0.4rem;
    font-size: var(--text-klein);
    color: var(--color-rauch-dunkel);
    white-space: nowrap;
  }
  .teller--gross {
    width: min(84%, 32rem);
    top: 0;
    right: -2%;
  }
  .teller--gross .teller-text {
    text-align: right;
    padding-right: 14%;
  }
  .teller--mittel {
    width: min(46%, 18.5rem);
    left: 1%;
    top: 45%;
  }
  .teller--mittel .teller-text {
    padding-left: 12%;
  }
  .teller--klein {
    width: min(34%, 14rem);
    right: 9%;
    top: 67%;
  }
  .teller--klein .teller-text {
    text-align: right;
    padding-right: 4%;
  }

  @media (width < 64rem) {
    .tafel {
      min-height: 0;
      height: 124vw;
      max-height: 42rem;
      margin-inline: -1rem;
    }
    .teller--gross {
      width: 90%;
      right: -6%;
    }
    .teller--mittel {
      width: 50%;
      left: -1%;
      top: 53%;
    }
    .teller--klein {
      width: 38%;
      right: 3%;
      top: 70%;
    }
  }

  @media (width >= 64rem) {
    .tafel {
      min-height: 46rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .js .teller-bild[data-erscheinen] {
      transform: scale(0.94);
    }
    .js .teller-bild[data-erscheinen].sichtbar {
      transform: none;
    }
  }
</style>
