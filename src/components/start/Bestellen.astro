---
import Icon from '../Icon.astro';
import { kontakt } from '../../data/kontakt';
import { bestellung } from '../../data/bestellung';
import { angebote } from '../../data/angebote';

const extras = [angebote.mittagsbuffet, angebote.catering].filter((a) => a.aktiv);
---

<!-- Bestellen: kein farbiges Band mehr, sondern eine Tafel auf der Tinte, von unten rechts von Glut angeleuchtet -->
<section id="bestellen" class="bestellen koernung bg-tinte py-16 text-creme md:py-24" aria-labelledby="bestellen-titel">
  <div class="rahmen">
    <div class="tafel">
      <div class="druck" aria-hidden="true"></div>
      <div class="relative grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 id="bestellen-titel" class="display-l">Lieber zu Hause essen?</h2>
          <span class="goldfaden" aria-hidden="true"></span>
          <p class="mt-5 max-w-[34rem] text-lead leading-relaxed text-rauch" data-erscheinen>
            Bestellen Sie über unser Online-Bestellportal – zur Lieferung nach Hause oder zur Abholung in der Oberen
            Hauptstraße. Oder ganz bequem mit der Bombay-App fürs iPhone.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:flex-col lg:items-stretch" data-erscheinen style="--verzoegerung:1">
          <a href={bestellung.url} class="knopf knopf-glut tafel-knopf">
            <Icon name="tasche" size={19} /> Online bestellen <Icon name="extern" size={16} />
          </a>
          <a href={kontakt.iosAppUrl} class="knopf knopf-kontur-hell tafel-knopf" rel="noopener">
            <Icon name="app" size={19} /> iOS-App im App Store <Icon name="extern" size={16} />
          </a>
        </div>

        {
          extras.length > 0 && (
            <div class="grid gap-6 border-t border-creme/15 pt-8 sm:grid-cols-2 lg:col-span-12">
              {extras.map((a) => (
                <div>
                  <h3 class="display-m">{a.titel}</h3>
                  <p class="mt-2 text-rauch">{a.text}</p>
                </div>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .tafel {
    position: relative;
    overflow: hidden;
    padding: 2.5rem 1.5rem;
    border-radius: 1.75rem;
    border: 1px solid color-mix(in oklab, var(--color-safran) 26%, transparent);
    background:
      radial-gradient(80% 120% at 100% 100%, color-mix(in oklab, var(--color-glut) 42%, transparent), transparent 62%),
      radial-gradient(50% 70% at 0% 0%, color-mix(in oklab, var(--color-kurkuma) 8%, transparent), transparent 70%),
      linear-gradient(160deg, #241c17, #1a1411);
    box-shadow:
      0 40px 80px -40px color-mix(in oklab, var(--color-russ) 90%, transparent),
      inset 0 1px 0 rgb(246 239 228 / 0.06);
  }
  @media (width >= 48rem) {
    .tafel {
      padding: 4rem 3.5rem;
    }
  }
  /* Großer Blockdruck in der Glut-Ecke, läuft nach links und oben aus */
  .druck {
    position: absolute;
    inset: 0 0 0 40%;
    pointer-events: none;
    background: url('/ornament/kachel-glut.svg') repeat 0 0 / 112px 112px;
    opacity: 0.55;
    -webkit-mask: radial-gradient(90% 110% at 100% 100%, #000 20%, transparent 75%);
    mask: radial-gradient(90% 110% at 100% 100%, #000 20%, transparent 75%);
  }
  @media (width < 64rem) {
    .druck {
      inset: 30% 0 0 0;
    }
  }
  .tafel-knopf {
    min-height: 3.5rem;
  }
</style>
