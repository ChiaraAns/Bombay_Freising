---
import Foto from '../Foto.astro';
import Icon from '../Icon.astro';
import LiveStatus from '../LiveStatus.astro';
import { bild } from '../../lib/bilder';
import { kontakt } from '../../data/kontakt';
import { pfad } from '../../lib/pfad';

// Hero-Foto: eigenes `hero.*` hat Vorrang, sonst das Garnelen-Curry (Nr. 93).
const heroBild = bild('hero') ?? bild('gericht-93-jheenga-masala');
---

<section class="hero koernung relative overflow-hidden bg-tinte" aria-labelledby="hero-titel">
  <div class="hero-foto" aria-hidden="false">
    <Foto
      bild={heroBild}
      alt="Riesengarnelen in kräftiger Masala-Soße mit Koriander in einer Karahi-Schale, daneben Basmati-Reis und rote Chilis"
      platzhalter="Bombay"
      sizes="100vw"
      verhaeltnis="auto"
      eager
      class="h-full w-full"
      bildKlasse="hero-bild"
      position="50% 46%"
    />
  </div>

  <div class="rahmen relative">
    <div class="hero-text">
      <span class="hero-ornament" aria-hidden="true"></span>
      <h1 id="hero-titel" class="hero-titel text-creme" data-woerter>Aus Glut und Gewürz.</h1>
      <p class="hero-unterzeile mt-5 max-w-[32rem] text-basis leading-relaxed text-rauch sm:text-lead">
        Tandoori und Naan aus dem Holzkohle-Lehmofen, hausgemachter Paneer<span class="hidden sm:inline"
          >{' '}und eine große vegetarische Karte</span
        > – mitten in der Freisinger Altstadt.
      </p>

      <div class="hero-knoepfe mt-7 grid grid-cols-2 gap-2.5 sm:flex sm:flex-wrap sm:gap-3">
        <a href={kontakt.telefonLink} class="knopf knopf-glut">
          <Icon name="telefon" size={18} class="hidden sm:block" />
          <span class="flex flex-col items-start leading-tight sm:block">
            <span><span class="sm:hidden">Reservieren</span><span class="hidden sm:inline">Tisch reservieren</span></span>
            <span class="tabellenziffern text-klein font-medium opacity-90 sm:hidden">{kontakt.telefonAnzeige}</span>
          </span>
        </a>
        <a href={pfad('/bestellen')} class="knopf knopf-kontur-hell">
          <Icon name="tasche" size={18} class="hidden sm:block" />
          <span class="flex flex-col items-start leading-tight sm:block">
            <span><span class="sm:hidden">Bestellen</span><span class="hidden sm:inline">Online bestellen</span></span>
            <span class="text-klein font-medium opacity-80 sm:hidden">Liefern · Abholen</span>
          </span>
        </a>
      </div>

      <div class="hero-fakten mt-7 flex flex-col gap-1 pt-4 text-fein sm:flex-row sm:items-center sm:gap-7">
        <LiveStatus class="text-creme" />
        <a href={kontakt.mapsUrl} class="inline-flex items-center gap-1.5 text-rauch no-underline hover:text-creme" rel="noopener">
          <Icon name="ort" size={17} />
          {kontakt.strasse}, {kontakt.ort}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
  }
  .hero-foto {
    position: relative;
    aspect-ratio: 4 / 3;
    /* Foto läuft nach unten weich in den dunklen Grund aus */
    -webkit-mask: linear-gradient(180deg, #000 55%, transparent 100%);
    mask: linear-gradient(180deg, #000 55%, transparent 100%);
  }
  .hero-foto :global(picture),
  .hero-foto :global(.platzhalter) {
    height: 100%;
  }
  .hero-text {
    position: relative;
    margin-top: -5.5rem;
    padding-bottom: 3rem;
  }
  .hero-ornament {
    display: block;
    width: 7.5rem;
    height: 12px;
    margin-bottom: 1.1rem;
    background: var(--color-rani-hell);
    -webkit-mask: url('/ornament/band.svg') repeat-x left center / auto 100%;
    mask: url('/ornament/band.svg') repeat-x left center / auto 100%;
  }
  .hero-titel {
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 1.35rem + 5vw, 5.6rem);
    line-height: 0.98;
    letter-spacing: -0.015em;
    text-shadow: 0 2px 30px color-mix(in oklab, var(--color-russ) 70%, transparent);
  }
  .hero-fakten {
    border-top: 1px solid color-mix(in oklab, var(--color-creme) 16%, transparent);
    max-width: 34rem;
  }

  @media (width < 40rem) {
    .hero-knoepfe :global(.knopf) {
      justify-content: flex-start;
      padding-inline: 0.85rem;
      min-height: 3.4rem;
    }
  }

  @media (width >= 48rem) {
    .hero {
      min-height: min(54rem, calc(100svh - 5rem));
      align-items: center;
    }
    .hero-foto {
      position: absolute;
      inset: 0 0 0 34%;
      aspect-ratio: auto;
      /* Foto rechts, nach links und nach unten weich in die Kohle hinein auslaufend */
      -webkit-mask:
        linear-gradient(90deg, transparent 0%, #000 38%),
        linear-gradient(180deg, #000 68%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask:
        linear-gradient(90deg, transparent 0%, #000 38%),
        linear-gradient(180deg, #000 68%, transparent 100%);
      mask-composite: intersect;
    }
    .hero-text {
      margin: 0;
      padding: 6rem 0 5rem;
      max-width: 40rem;
    }
  }

  /* Langsames „Atmen“ des Fotos – kaum merklich */
  @media (prefers-reduced-motion: no-preference) {
    .hero :global(.hero-bild) {
      animation: hero-zoom 18s var(--ease-glut) both;
    }
    @keyframes hero-zoom {
      from {
        transform: scale(1.08);
      }
      to {
        transform: scale(1);
      }
    }
    .hero-ornament,
    .hero-unterzeile,
    .hero-knoepfe,
    .hero-fakten {
      animation: hero-auf 1.2s var(--ease-glut) both;
    }
    .hero-ornament {
      animation-delay: 0.1s;
    }
    .hero-unterzeile {
      animation-delay: 0.75s;
    }
    .hero-knoepfe {
      animation-delay: 0.9s;
    }
    .hero-fakten {
      animation-delay: 1.05s;
    }
    @keyframes hero-auf {
      from {
        opacity: 0;
        transform: translateY(22px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
