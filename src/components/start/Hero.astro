---
import Foto from '../Foto.astro';
import Icon from '../Icon.astro';
import LiveStatus from '../LiveStatus.astro';
import { bild } from '../../lib/bilder';
import { kontakt } from '../../data/kontakt';
import { bestellung } from '../../data/bestellung';

// Hero-Foto: eigenes `hero.*` hat Vorrang, sonst das Garnelen-Curry (Nr. 93).
const heroBild = bild('hero') ?? bild('gericht-93-jheenga-masala');
---

<section class="hero koernung relative overflow-hidden bg-tinte" aria-labelledby="hero-titel">
  <div class="hero-foto" aria-hidden="false">
    <Foto
      bild={heroBild}
      alt="Riesengarnelen in kräftiger Masala-Soße mit Koriander in einer Karahi-Schale, daneben Basmati-Reis und rote Chilis"
      platzhalter="Bombay"
      sizes="100vw"
      verhaeltnis="auto"
      eager
      class="h-full w-full"
      bildKlasse="hero-bild"
      position="50% 46%"
    />
  </div>

  <div class="rahmen relative">
    <div class="hero-text">
      <span class="hero-ornament" aria-hidden="true"></span>
      <h1 id="hero-titel" class="hero-titel text-creme" data-woerter>Aus Glut und Gewürz.</h1>
      <p class="hero-unterzeile mt-5 max-w-[32rem] text-basis leading-relaxed text-rauch sm:text-lead">
        Tandoori und Naan aus dem Holzkohle-Lehmofen, hausgemachter Paneer<span class="hidden sm:inline"
          >{' '}und eine große vegetarische Karte</span
        > – mitten in der Freisinger Altstadt.
      </p>

      <div class="hero-knoepfe mt-7 grid grid-cols-2 gap-2.5 sm:flex sm:flex-wrap sm:gap-3">
        <a href={kontakt.telefonLink} class="knopf knopf-glut">
          <Icon name="telefon" size={18} class="hidden sm:block" />
          <span class="flex flex-col items-center leading-tight sm:block">
            <span><span class="sm:hidden">Reservieren</span><span class="hidden sm:inline">Tisch reservieren</span></span>
            <span class="knopf-zeile2 tabellenziffern sm:hidden">{kontakt.telefonAnzeige}</span>
          </span>
        </a>
        <a href={bestellung.url} class="knopf knopf-kontur-hell">
          <Icon name="tasche" size={18} class="hidden sm:block" />
          <span class="flex flex-col items-center leading-tight sm:block">
            <span><span class="sm:hidden">Bestellen</span><span class="hidden sm:inline">Online bestellen</span></span>
            <span class="knopf-zeile2 sm:hidden">Liefern · Abholen</span>
          </span>
        </a>
      </div>

      <!-- Die drei Fakten: offen?, Reservierung, Adresse – groß und auf einen Blick -->
      <dl class="hero-fakten mt-6 sm:mt-9">
        <div class="fakt fakt-status">
          <dt class="fakt-label">Heute</dt>
          <dd><LiveStatus gross class="text-creme" /></dd>
        </div>
        <div class="fakt fakt-telefon">
          <dt class="fakt-label">Tisch reservieren</dt>
          <dd>
            <a href={kontakt.telefonLink} class="fakt-wert tabellenziffern">{kontakt.telefonAnzeige}</a>
            <span class="fakt-zusatz">Reservierung nur telefonisch</span>
          </dd>
        </div>
        <div class="fakt fakt-adresse">
          <dt class="fakt-label">Freisinger Altstadt</dt>
          <dd>
            <a href={kontakt.mapsUrl} class="fakt-wert" rel="noopener">{kontakt.strasse}</a>
            <span class="fakt-zusatz">{kontakt.plz} {kontakt.ort} · <a href={kontakt.mapsUrl} rel="noopener">Route planen</a></span>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
  }
  .hero-foto {
    position: relative;
    aspect-ratio: 16 / 11;
    /* Foto läuft oben unter der Kopfzeile und nach unten weich in den dunklen Grund aus – keine harte Kante */
    -webkit-mask: linear-gradient(180deg, transparent 0%, #000 9%, #000 55%, transparent 100%);
    mask: linear-gradient(180deg, transparent 0%, #000 9%, #000 55%, transparent 100%);
  }
  .hero-foto :global(picture),
  .hero-foto :global(.platzhalter) {
    height: 100%;
  }
  .hero-text {
    position: relative;
    isolation: isolate;
    margin-top: -5.5rem;
    padding-bottom: 3rem;
  }
  .hero-ornament {
    display: block;
    width: 7.5rem;
    height: 12px;
    margin-bottom: 1.1rem;
    background: var(--glanz);
    -webkit-mask: url('/ornament/band.svg') repeat-x left center / auto 100%;
    mask: url('/ornament/band.svg') repeat-x left center / auto 100%;
  }
  .hero-titel {
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 1.35rem + 5vw, 5.6rem);
    line-height: 0.98;
    letter-spacing: -0.015em;
    text-shadow: 0 2px 30px color-mix(in oklab, var(--color-russ) 70%, transparent);
  }
  /* Fakten: Haarlinie oben, drei Spalten mit feinen Trennern; Beschriftung klein in Safran, Wert groß */
  .hero-fakten {
    display: grid;
    gap: 1.1rem 0;
    padding-top: 1.4rem;
    border-top: 1px solid color-mix(in oklab, var(--color-creme) 14%, transparent);
    max-width: 52rem;
  }
  .fakt {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }
  .fakt-label {
    color: var(--color-safran);
    font-size: var(--text-mini);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .fakt dd {
    display: grid;
    gap: 0.3rem;
    margin: 0;
  }
  .fakt-wert {
    white-space: nowrap;
    color: var(--color-creme);
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0.01em;
    text-decoration: none;
    width: fit-content;
    background: linear-gradient(var(--color-safran), var(--color-safran)) no-repeat left bottom / 0 1px;
    transition: background-size 0.4s var(--ease-glut);
  }
  .fakt-wert:hover {
    background-size: 100% 1px;
  }
  .fakt-zusatz {
    color: var(--color-rauch);
    font-size: var(--text-fein);
  }
  .fakt-zusatz a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--color-safran) 70%, transparent);
  }
  /* Telefon steht mobil schon im Knopf und in der Leiste unten */
  .fakt-telefon {
    display: none;
  }
  .knopf-zeile2 {
    margin-top: 0.2rem;
    font-size: var(--text-klein);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
    opacity: 0.85;
  }

  @media (width < 40rem) {
    .hero-knoepfe :global(.knopf) {
      min-height: 3.6rem;
      padding-inline: 0.75rem;
    }
    /* Handy: Zustand und Straße müssen über der Leiste unten stehen – Beschriftungen nur für Screenreader,
       Zusatz zum Zustand in derselben Zeile */
    .hero-fakten {
      grid-template-columns: 1fr 1fr;
      gap: 0.7rem;
      padding-top: 1rem;
    }
    .fakt-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .fakt-status :global(.live-gross) {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: 0.75rem;
    }
    .fakt-status :global(.live-zusatz) {
      padding-left: 0;
    }
    .fakt-status {
      grid-column: 1 / -1;
    }
    .fakt-adresse {
      grid-column: 1 / -1;
    }
  }
  @media (width >= 40rem) {
    .hero-fakten {
      grid-template-columns: auto auto auto;
      justify-content: start;
    }
    .fakt-telefon {
      display: grid;
    }
    .fakt + .fakt {
      padding-left: 1.75rem;
      margin-left: 1.75rem;
      border-left: 1px solid color-mix(in oklab, var(--color-creme) 12%, transparent);
    }
  }

  @media (width >= 48rem) {
    .hero {
      min-height: min(54rem, calc(100svh - 5rem));
      align-items: center;
    }
    .hero-foto {
      position: absolute;
      inset: 0 0 0 40%;
      aspect-ratio: auto;
      /* Foto rechts, nach links, oben und unten weich in die Kohle hinein auslaufend */
      -webkit-mask:
        linear-gradient(90deg, transparent 0%, #000 34%),
        linear-gradient(180deg, transparent 0%, #000 11%, #000 68%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask:
        linear-gradient(90deg, transparent 0%, #000 34%),
        linear-gradient(180deg, transparent 0%, #000 11%, #000 68%, transparent 100%);
      mask-composite: intersect;
    }
    .hero-text {
      margin: 0;
      padding: 6rem 0 5rem;
      max-width: 46rem;
    }
    /* Weicher Schatten hinter Text und Fakten: das Foto taucht darunter in die Kohle, ohne Kasten */
    .hero-text::before {
      content: '';
      position: absolute;
      inset: -2rem -8rem -2rem -30vw;
      z-index: -1;
      pointer-events: none;
      background: radial-gradient(
        closest-side at 45% 60%,
        color-mix(in oklab, var(--color-tinte) 88%, transparent),
        color-mix(in oklab, var(--color-tinte) 55%, transparent) 60%,
        transparent
      );
    }
  }

  /* Langsames „Atmen“ des Fotos – kaum merklich */
  @media (prefers-reduced-motion: no-preference) {
    .hero :global(.hero-bild) {
      animation: hero-zoom 18s var(--ease-glut) both;
    }
    @keyframes hero-zoom {
      from {
        transform: scale(1.08);
      }
      to {
        transform: scale(1);
      }
    }
    /* Die wichtigen Fakten (Knöpfe, Live-Status) sind nach spätestens einer knappen Sekunde da */
    .hero-ornament,
    .hero-unterzeile,
    .hero-knoepfe,
    .hero-fakten {
      animation: hero-auf 0.6s var(--ease-glut) both;
    }
    .hero-unterzeile {
      animation-delay: 0.22s;
    }
    .hero-knoepfe {
      animation-delay: 0.3s;
    }
    .hero-fakten {
      animation-delay: 0.35s;
    }
    /* Mit Logo-Vorhang: alles 1,25 s später, wenn der Vorhang sich hebt */
    :global(.vorhang-an) .hero-ornament {
      animation-delay: 1.25s;
    }
    :global(.vorhang-an) .hero-unterzeile {
      animation-delay: 1.47s;
    }
    :global(.vorhang-an) .hero-knoepfe {
      animation-delay: 1.55s;
    }
    :global(.vorhang-an) .hero-fakten {
      animation-delay: 1.6s;
    }
    @keyframes hero-auf {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
