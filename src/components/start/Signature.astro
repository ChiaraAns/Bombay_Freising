---
import { pfad } from '../../lib/pfad';
import GerichtEtikett from '../GerichtEtikett.astro';
import Icon from '../Icon.astro';
import { signatureNummern, gerichtNr } from '../../data/speisekarte';

const altTexte: Record<number, string> = {
  57: 'Butter Chicken in einer Karahi-Schale mit Sahnehaube und Bockshornkleeblättern auf dunklem Holztisch',
  58: 'Chicken Tikka Masala mit gegrillten Hühnerstücken in orangefarbener Soße, Sahne und Koriander in einer Karahi mit Messinggriffen, daneben Naan und Reis',
  104: 'Palak Paneer: Paneer-Würfel in sattgrünem Spinat mit Sahne, Ingwerstreifen und Koriander in einer dunklen Schale',
  128: 'Thali-Platte mit Curry, Linsen, Salat, Raita, gegrilltem Hähnchen, Pappad, Naan, Basmati-Reis und einer Süßspeise in Metallschälchen',
  96: 'Jheenga Mango: Riesengarnelen mit Mangowürfeln und Paprika in goldgelber Soße in einer Karahi, daneben eine aufgeschnittene Mango',
  159: 'Garlic Naan mit Knoblauchbutter und Kräutern, gestapelt in einem Korb auf grünem Leinentuch',
};
const gerichte = signatureNummern.map((nr) => gerichtNr(nr));
---

<section id="karte" class="signature naht koernung py-20 text-creme md:py-28" aria-labelledby="karte-titel">
  <div class="rahmen">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-[38rem]">
        <h2 id="karte-titel" class="display-l">Sechs Gründe, heute indisch zu essen.</h2>
        <span class="goldfaden" aria-hidden="true"></span>
        <p class="mt-4 text-lead leading-relaxed text-rauch" data-erscheinen>
          Eine kleine Auswahl aus über 120 Gerichten. Die Nummer hilft, wenn Sie telefonisch bestellen.
        </p>
      </div>
    </div>

    <ul class="etiketten nacht mt-12" role="list">
      {
        gerichte.map((g, i) => (
          <li data-erscheinen style={`--verzoegerung:${i % 3}`}>
            <GerichtEtikett gericht={g} alt={altTexte[g.nr!] ?? g.name} />
          </li>
        ))
      }
    </ul>

    <div class="mt-12 flex justify-center">
      <a href={pfad('/speisekarte')} class="knopf knopf-glut ganze-karte w-full sm:w-auto">
        Ganze Speisekarte ansehen
        <Icon name="pfeil" size={18} />
      </a>
    </div>
  </div>
</section>

<style>
  .etiketten {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }
  @media (width < 40rem) {
    .etiketten {
      grid-auto-flow: column;
      grid-template-columns: none;
      grid-auto-columns: 84%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: -1rem;
      padding: 0.25rem 1rem 1.25rem;
      scroll-padding-inline: 1rem;
      gap: 1rem;
    }
    .etiketten > li {
      scroll-snap-align: start;
    }
    /* In der Wisch-Reihe sind alle Karten sofort sichtbar (kein Einblenden beim seitlichen Wischen) */
    :global(.js) .etiketten > li[data-erscheinen] {
      opacity: 1;
      transform: none;
    }
  }
  .ganze-karte {
    min-height: 3.5rem;
    padding-inline: 2.25rem;
  }
  /* Kein Bühnenwechsel: der Abschnitt hebt sich nur als leiser Tonwechsel aus der Tinte, Kanten laufen weich aus */
  .signature {
    background: linear-gradient(
      180deg,
      var(--color-tinte) 0%,
      #201a16 14%,
      #201a16 86%,
      var(--color-tinte) 100%
    );
  }
</style>
