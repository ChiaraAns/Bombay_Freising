---
import Icon from '../Icon.astro';
import LiveStatus from '../LiveStatus.astro';
import { kontakt } from '../../data/kontakt';
import { wochentagNamen, feiertagsHinweis, oeffnungszeiten } from '../../data/oeffnungszeiten';
import { fensterText } from '../../lib/zeiten';
import { bild, srcset, fallbackSrc } from '../../lib/bilder';

// Ambiente-Foto (`ambiente-1.*`) liegt hinter dem Karten-Hinweis, solange die Karte nicht geladen ist.
const ambiente = bild('ambiente-1');

const tage = [1, 2, 3, 4, 5, 6, 7].map((t) => ({
  tag: t,
  name: wochentagNamen[t],
  text: fensterText(t),
  fenster: oeffnungszeiten[t] ?? [],
}));
const mapsEmbed =
  'https://www.google.com/maps?output=embed&q=' +
  encodeURIComponent(`Bombay, ${kontakt.strasse}, ${kontakt.plz} ${kontakt.ort}`);
---

<section id="besuch" class="hell bg-creme py-20 text-tinte md:py-28" aria-labelledby="besuch-titel">
  <div class="rahmen">
    <h2 id="besuch-titel" class="display-l max-w-[40rem]" data-erscheinen>Besuchen Sie uns in der Altstadt.</h2>

    <div class="mt-12 grid gap-8 lg:grid-cols-12 lg:gap-10">
      <!-- Öffnungszeiten -->
      <div class="zeiten etikett p-2.5 lg:col-span-5" data-erscheinen>
        <span class="bordure text-rani" aria-hidden="true"></span>
        <div class="px-4 pb-5 pt-5 sm:px-6">
          <h3 class="display-m flex items-center gap-2.5"><Icon name="uhr" size={24} class="text-glut" /> Öffnungszeiten</h3>
          <LiveStatus class="mt-3 text-tinte" />
          <table class="tabellenziffern mt-4 w-full border-collapse text-[1.05rem]" data-zeiten-tabelle>
            <caption class="sr-only">Öffnungszeiten nach Wochentag</caption>
            <tbody>
              {
                tage.map((t) => (
                  <tr data-tag={t.tag} class:list={[t.text === 'Ruhetag' && 'ruhetag']}>
                    <th scope="row" class="py-2.5 pr-4 text-left font-semibold">
                      {t.name}
                      <span class="heute-marke" hidden>
                        heute
                      </span>
                    </th>
                    <td class="py-2.5 text-right">
                      {t.fenster.length
                        ? t.fenster.map((f, i) => (
                            <span class="block sm:inline">
                              {i > 0 && <span class="hidden sm:inline"> · </span>}
                              {f.von}–{f.bis}
                            </span>
                          ))
                        : 'Ruhetag'}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p class="mt-4 flex items-center gap-2 font-semibold text-kardamom">
            <Icon name="stern" size={16} />
            {feiertagsHinweis}
          </p>
        </div>
      </div>

      <!-- Anfahrt & Kontakt -->
      <div class="grid content-start gap-8 lg:col-span-7" data-erscheinen style="--verzoegerung:1">
        <div class="grid gap-8 sm:grid-cols-2">
          <div>
            <h3 class="display-m">Anfahrt</h3>
            <address class="mt-3 text-[1.1rem] not-italic leading-relaxed">
              Bombay – Indische Spezialitäten<br />
              {kontakt.strasse}<br />
              {kontakt.plz} {kontakt.ort}
            </address>
            <p class="mt-3 text-braun">
              Mitten in der Freisinger Altstadt und in der Nähe des Flughafens München – auch für Reisende und
              Hotelgäste gut erreichbar.
            </p>
            <a href={kontakt.mapsUrl} class="knopf knopf-kontur mt-5" rel="noopener">
              <Icon name="ort" size={19} /> Route in Google Maps
            </a>
          </div>
          <div>
            <h3 class="display-m">Reservierung &amp; Kontakt</h3>
            <p class="mt-3 text-braun">Tische reservieren Sie am einfachsten telefonisch.</p>
            <a href={kontakt.telefonLink} class="knopf knopf-glut mt-4 text-[1.15rem]">
              <Icon name="telefon" size={19} />
              <span class="tabellenziffern">{kontakt.telefonAnzeige}</span>
            </a>
            <p class="mt-5">
              <a href={`mailto:${kontakt.email}`} class="inline-flex items-center gap-2 break-all text-tinte underline">
                <Icon name="brief" size={19} class="shrink-0 text-glut" />
                {kontakt.email}
              </a>
            </p>
          </div>
        </div>

        <!-- Karte nur nach Zustimmung (Zwei-Klick-Lösung) -->
        <div class="karte-rahmen relative overflow-hidden" data-karte>
          <div class="karte-hinweis rapport-hintergrund flex h-full flex-col items-start justify-end gap-3 p-5 sm:p-7">
            {
              ambiente && (
                <picture class="absolute inset-0 -z-10">
                  <source type="image/avif" srcset={srcset(ambiente, 'avif')} sizes="(min-width: 64rem) 45rem, 100vw" />
                  <source type="image/webp" srcset={srcset(ambiente, 'webp')} sizes="(min-width: 64rem) 45rem, 100vw" />
                  <img src={fallbackSrc(ambiente)} alt="Gastraum des Bombay in der Freisinger Altstadt" loading="lazy" class="h-full w-full object-cover opacity-60" />
                </picture>
              )
            }
            <p class="max-w-[30rem] text-[0.98rem] text-creme">
              Mit Klick auf „Karte laden“ wird eine Karte von Google Maps eingebunden. Dabei werden Daten (u. a. Ihre
              IP-Adresse) an Google übertragen. Mehr dazu in der <a href="/datenschutz" class="underline">Datenschutzerklärung</a>.
            </p>
            <button type="button" class="knopf knopf-creme" data-karte-laden>
              <Icon name="karte" size={19} /> Karte laden
            </button>
          </div>
          <template data-karte-vorlage>
            <iframe
              src={mapsEmbed}
              title="Lage des Restaurants Bombay in Freising auf Google Maps"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="absolute inset-0 h-full w-full border-0"></iframe>
          </template>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { heutigerWochentag } from '../../lib/status';

  const heute = heutigerWochentag();
  document.querySelectorAll<HTMLTableRowElement>('[data-zeiten-tabelle] tr').forEach((tr) => {
    const ist = Number(tr.dataset.tag) === heute;
    tr.classList.toggle('heute', ist);
    if (ist) tr.setAttribute('aria-current', 'date');
    const marke = tr.querySelector<HTMLElement>('.heute-marke');
    if (marke) marke.hidden = !ist;
  });

  const karte = document.querySelector<HTMLElement>('[data-karte]');
  karte?.querySelector('[data-karte-laden]')?.addEventListener('click', () => {
    const vorlage = karte.querySelector<HTMLTemplateElement>('[data-karte-vorlage]');
    if (!vorlage) return;
    karte.querySelector('.karte-hinweis')?.remove();
    karte.append(vorlage.content.cloneNode(true));
    karte.querySelector('iframe')?.focus();
  });
</script>

<style>
  tr {
    border-bottom: 1px solid rgb(27 23 20 / 0.12);
  }
  tr:last-child {
    border-bottom: 0;
  }
  .ruhetag td {
    color: var(--color-glut);
    font-weight: 600;
  }
  tr.heute {
    background: var(--color-tinte);
    color: var(--color-creme);
  }
  tr.heute th,
  tr.heute td {
    padding-inline: 0.75rem;
  }
  tr.heute.ruhetag td {
    color: var(--color-safran);
  }
  .heute-marke {
    margin-left: 0.5rem;
    padding: 0.1rem 0.45rem 0;
    background: var(--color-safran);
    color: var(--color-tinte);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 2px;
    vertical-align: 0.15em;
  }
  .karte-rahmen {
    height: clamp(17rem, 38vw, 24rem);
    background: var(--color-tinte);
  }
  .rapport-hintergrund {
    position: relative;
    isolation: isolate;
    background: linear-gradient(160deg, var(--color-kohle), var(--color-tinte));
  }
  .rapport-hintergrund::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(232 163 61 / 0.12);
    -webkit-mask: url('/ornament/kachel.svg') repeat center / 56px 56px;
    mask: url('/ornament/kachel.svg') repeat center / 56px 56px;
  }
</style>
