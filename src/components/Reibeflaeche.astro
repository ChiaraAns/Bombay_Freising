---
import { pfad } from '../lib/pfad';
/**
 * Mobile Aktionsleiste unten – die „Reibefläche“ der Streichholzschachtel.
 * Anrufen · Bestellen · Karte: auf jedem Bildschirm mit einem Daumen erreichbar.
 */
import Icon from './Icon.astro';
import { kontakt } from '../data/kontakt';
import { bestellung } from '../data/bestellung';
---

<nav
  aria-label="Schnellzugriff"
  class="reibeflaeche fixed inset-x-0 bottom-0 z-50 pb-[env(safe-area-inset-bottom)] md:hidden print:hidden"
>
  <ul class="grid grid-cols-3" role="list">
    <li>
      <a href={kontakt.telefonLink} class="reibe-link">
        <Icon name="telefon" size={21} />
        <span>Anrufen</span>
      </a>
    </li>
    <li>
      <a href={bestellung.url} class="reibe-link">
        <Icon name="tasche" size={21} />
        <span>Bestellen</span>
      </a>
    </li>
    <li>
      <a href={pfad('/speisekarte')} class="reibe-link">
        <Icon name="karte" size={21} />
        <span>Speisekarte</span>
      </a>
    </li>
  </ul>
</nav>

<style>
  /* Dunkle Leiste mit Haarlinie, wie die Kopfzeile; „Bestellen“ trägt die Glut */
  .reibeflaeche {
    background: var(--color-russ);
    border-top: 1px solid color-mix(in oklab, var(--color-safran) 28%, transparent);
    box-shadow: 0 -12px 30px -14px color-mix(in oklab, var(--color-russ) 80%, transparent);
  }
  .reibe-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 0.65rem 0 0.55rem;
    color: var(--color-creme);
    font-weight: 600;
    font-size: var(--text-mini);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }
  li:nth-child(2) .reibe-link {
    color: var(--color-safran);
  }
  li + li .reibe-link {
    border-left: 1px solid color-mix(in oklab, var(--color-creme) 10%, transparent);
  }
  .reibe-link:active {
    background: color-mix(in oklab, var(--color-creme) 6%, transparent);
  }
</style>
