---
import { pfad } from '../lib/pfad';
import Icon from './Icon.astro';
import LogoEtikett from './LogoEtikett.astro';
import { kontakt } from '../data/kontakt';

interface Props {
  aktiv?: 'start' | 'speisekarte' | 'recht';
}
const { aktiv = 'start' } = Astro.props;

const links = [
  { href: pfad('/speisekarte'), text: 'Speisekarte', id: 'speisekarte' },
  { href: pfad('/#kompass'), text: 'Curry-Kompass' },
  { href: pfad('/#bestellen'), text: 'Lieferung & Abholung' },
  { href: pfad('/#besuch'), text: 'Öffnungszeiten & Anfahrt' },
];
---

<header class="kopf koernung relative z-40 border-b border-white/8 bg-tinte">
  <div class="rahmen flex h-[4.25rem] items-center justify-between gap-6 md:h-[5rem]">
    <a href={pfad('/')} class="kopf-marke flex shrink-0 items-center gap-4 no-underline" aria-label="Bombay – Indische Spezialitäten, zur Startseite">
      <LogoEtikett />
      <span class="feinsatz hidden text-mini leading-tight text-rauch-dunkel xl:block" style="letter-spacing:.14em" aria-hidden="true"
        >Indische<br />Spezialitäten</span
      >
    </a>

    <nav aria-label="Hauptnavigation" class="hidden lg:block">
      <ul class="flex items-center gap-7 text-basis font-medium" role="list">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="kopf-link text-rauch no-underline transition-colors hover:text-creme"
                aria-current={l.id === aktiv ? 'page' : undefined}
              >
                {l.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={kontakt.telefonLink} class="knopf knopf-glut hidden min-h-11 px-4 text-fein md:inline-flex">
        <Icon name="telefon" size={18} />
        <span class="tabellenziffern">{kontakt.telefonAnzeige}</span>
      </a>
      <button
        type="button"
        class="menue-knopf inline-flex h-11 w-11 items-center justify-center rounded-[3px] text-creme ring-1 ring-white/20 lg:hidden"
        aria-expanded="false"
        aria-controls="mobil-menue"
        aria-label="Menü öffnen"
      >
        <Icon name="menue" size={22} class="menue-auf" />
        <Icon name="kreuz" size={22} class="menue-zu hidden" />
      </button>
    </div>
  </div>

  <nav id="mobil-menue" aria-label="Menü" class="mobil-menue border-t border-white/8 bg-tinte lg:hidden" hidden>
    <ul class="rahmen flex flex-col py-3" role="list">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="flex items-center justify-between border-b border-white/8 py-3.5 font-display text-zwischen leading-tight text-creme no-underline"
            >
              {l.text}
              <Icon name="pfeil" size={20} class="text-safran" />
            </a>
          </li>
        ))
      }
      <li class="pt-4 pb-2">
        <a href={`mailto:${kontakt.email}`} class="text-rauch underline">{kontakt.email}</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const knopf = document.querySelector<HTMLButtonElement>('.menue-knopf');
  const menue = document.getElementById('mobil-menue');
  if (knopf && menue) {
    const setze = (offen: boolean) => {
      knopf.setAttribute('aria-expanded', String(offen));
      knopf.setAttribute('aria-label', offen ? 'Menü schließen' : 'Menü öffnen');
      menue.hidden = !offen;
      knopf.querySelector('.menue-auf')?.classList.toggle('hidden', offen);
      knopf.querySelector('.menue-zu')?.classList.toggle('hidden', !offen);
    };
    knopf.addEventListener('click', () => setze(knopf.getAttribute('aria-expanded') !== 'true'));
    menue.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setze(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menue.hidden) {
        setze(false);
        knopf.focus();
      }
    });
  }
</script>

<style>
  .kopf-link[aria-current='page'] {
    color: var(--color-creme);
    text-decoration: underline;
    text-decoration-color: var(--color-safran);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
</style>
