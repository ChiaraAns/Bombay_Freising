---
import { pfad } from '../lib/pfad';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { kontakt } from '../data/kontakt';
import { bestellung } from '../data/bestellung';

interface Props {
  aktiv?: 'start' | 'speisekarte' | 'recht';
}
const { aktiv = 'start' } = Astro.props;

const links = [
  { href: pfad('/speisekarte'), text: 'Speisekarte', id: 'speisekarte' },
  { href: pfad('/#kompass'), text: 'Curry-Kompass' },
  { href: bestellung.url, text: 'Online bestellen' },
  { href: pfad('/#besuch'), text: 'Öffnungszeiten & Anfahrt' },
];
---

<header class="kopf koernung relative z-40 border-b border-white/8 bg-tinte">
  <div class="rahmen flex h-[4.25rem] items-center justify-between gap-6 md:h-[5rem]">
    <a href={pfad('/')} class="kopf-marke flex shrink-0 items-center gap-4 no-underline" aria-label="Bombay – Indische Spezialitäten, zur Startseite">
      <Logo />
      <span class="feinsatz hidden text-mini leading-tight text-rauch-dunkel min-[88rem]:block" style="letter-spacing:.14em" aria-hidden="true"
        >Indische<br />Spezialitäten</span
      >
    </a>

    <nav aria-label="Hauptnavigation" class="hidden xl:block">
      <ul class="flex items-center gap-6 xl:gap-8" role="list">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="kopf-link no-underline"
                aria-current={l.id === aktiv ? 'page' : undefined}
              >
                {l.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={kontakt.telefonLink} class="kopf-telefon hidden md:inline-flex" aria-label={`Tisch reservieren: ${kontakt.telefonAnzeige}`}>
        <span class="kopf-telefon-label hidden sm:inline" aria-hidden="true">Reservieren</span>
        <span class="tabellenziffern" aria-hidden="true">{kontakt.telefonAnzeige}</span>
      </a>
      <button
        type="button"
        class="menue-knopf inline-flex h-11 w-11 items-center justify-center rounded-full text-creme ring-1 ring-white/20 xl:hidden"
        aria-expanded="false"
        aria-controls="mobil-menue"
        aria-label="Menü öffnen"
      >
        <Icon name="menue" size={22} class="menue-auf" />
        <Icon name="kreuz" size={22} class="menue-zu hidden" />
      </button>
    </div>
  </div>

  <nav id="mobil-menue" aria-label="Menü" class="mobil-menue border-t border-white/8 bg-tinte xl:hidden" hidden>
    <ul class="rahmen flex flex-col py-3" role="list">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="flex items-center justify-between border-b border-white/8 py-3.5 font-display text-zwischen leading-tight text-creme no-underline"
            >
              {l.text}
              <Icon name="pfeil" size={20} class="text-safran" />
            </a>
          </li>
        ))
      }
      <li class="pt-4 pb-2">
        <a href={`mailto:${kontakt.email}`} class="text-rauch underline">{kontakt.email}</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const knopf = document.querySelector<HTMLButtonElement>('.menue-knopf');
  const menue = document.getElementById('mobil-menue');
  if (knopf && menue) {
    const setze = (offen: boolean) => {
      knopf.setAttribute('aria-expanded', String(offen));
      knopf.setAttribute('aria-label', offen ? 'Menü schließen' : 'Menü öffnen');
      menue.hidden = !offen;
      knopf.querySelector('.menue-auf')?.classList.toggle('hidden', offen);
      knopf.querySelector('.menue-zu')?.classList.toggle('hidden', !offen);
    };
    knopf.addEventListener('click', () => setze(knopf.getAttribute('aria-expanded') !== 'true'));
    menue.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setze(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menue.hidden) {
        setze(false);
        knopf.focus();
      }
    });
  }
</script>

<style>
  /* Feine, gesperrte Navigation wie auf einem Schild */
  .kopf-link {
    position: relative;
    display: inline-block;
    white-space: nowrap;
    padding-block: 0.4rem;
    color: var(--color-rauch);
    font-size: var(--text-mini);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color 0.3s var(--ease-glut);
  }
  .kopf-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.16em;
    bottom: 0;
    height: 1px;
    background: var(--color-safran);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-glut);
  }
  .kopf-link:hover {
    color: var(--color-creme);
  }
  .kopf-link:hover::after,
  .kopf-link[aria-current='page']::after {
    transform: scaleX(1);
  }
  .kopf-link[aria-current='page'] {
    color: var(--color-creme);
  }

  /* Reservieren-Pille oben rechts: Glutkante, Beschriftung in Safran, Nummer in Creme */
  .kopf-telefon {
    align-items: center;
    white-space: nowrap;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.45rem 1.25rem 0.35rem;
    border: 1px solid color-mix(in oklab, var(--color-safran) 70%, transparent);
    border-radius: 999px;
    color: var(--color-creme);
    font-weight: 600;
    font-size: var(--text-fein);
    letter-spacing: 0.04em;
    text-decoration: none;
    box-shadow: 0 0 14px -4px rgb(232 163 61 / 0.45);
    transition:
      background-color 0.3s var(--ease-glut),
      box-shadow 0.3s var(--ease-glut);
  }
  .kopf-telefon:hover {
    background: color-mix(in oklab, var(--color-safran) 10%, transparent);
    box-shadow: 0 0 20px -3px rgb(232 163 61 / 0.6);
  }
  .kopf-telefon-label {
    color: var(--color-safran);
    font-size: var(--text-mini);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
</style>
