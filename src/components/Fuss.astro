---
import { pfad } from '../lib/pfad';
import Logo from './Logo.astro';
import { kontakt } from '../data/kontakt';
import { feiertagsHinweis } from '../data/oeffnungszeiten';
import { zeitenKompakt } from '../lib/zeiten';

const zeiten = zeitenKompakt();
---

<footer class="fuss koernung bg-russ text-rauch">
  <div class="rahmen pb-10 pt-20 md:pt-24">
    <!-- Marke: großes Logo, zentriert, ohne Hintergrund -->
    <div class="fuss-marke flex flex-col items-center text-center" data-erscheinen>
      <a href={pfad('/')} aria-label="Bombay – zur Startseite" class="inline-block">
        <Logo groesse="fuss" />
      </a>
      <p class="feinsatz mt-5 text-mini text-rauch-dunkel" style="letter-spacing:.22em">
        <span class="whitespace-nowrap">Indische Spezialitäten</span><span class="fuss-punkt" aria-hidden="true">
          ·
        </span><span class="whitespace-nowrap">Freisinger Altstadt</span>
      </p>
      <span class="fuss-linie mt-8" aria-hidden="true"></span>
    </div>

    <div class="mt-12 grid gap-10 text-center md:grid-cols-3 md:gap-8">
      <div>
        <h2 class="font-display text-zwischen text-creme">Besuch</h2>
        <address class="mt-4 not-italic leading-relaxed">
          {kontakt.strasse}<br />
          {kontakt.plz} {kontakt.ort}
        </address>
        <p class="mt-3 leading-relaxed">
          <a href={kontakt.telefonLink} class="fuss-link tabellenziffern">{kontakt.telefonAnzeige}</a><br />
          <a href={`mailto:${kontakt.email}`} class="fuss-link break-all">{kontakt.email}</a>
        </p>
      </div>

      <div>
        <h2 class="font-display text-zwischen text-creme">Öffnungszeiten</h2>
        <dl class="tabellenziffern mx-auto mt-4 grid w-max grid-cols-[auto_auto] gap-x-4 gap-y-1.5 text-left">
          {
            zeiten.map((z) => (
              <>
                <dt class="font-semibold text-creme">{z.tage}</dt>
                <dd>{z.text}</dd>
              </>
            ))
          }
        </dl>
        <p class="mt-3 text-fein">{feiertagsHinweis}</p>
      </div>

      <div>
        <h2 class="font-display text-zwischen text-creme">Bombay online</h2>
        <ul class="mt-4 space-y-1.5" role="list">
          <li><a href={pfad('/speisekarte')} class="fuss-link">Speisekarte</a></li>
          <li><a href={pfad('/bestellen')} class="fuss-link">Online bestellen</a></li>
          <li><a href={kontakt.iosAppUrl} class="fuss-link" rel="noopener">iOS-App</a></li>
          <li><a href={kontakt.mapsUrl} class="fuss-link" rel="noopener">Route in Google Maps</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-col items-center gap-4 border-t border-white/8 pt-6 text-fein md:flex-row md:justify-between">
      <p>© {new Date().getFullYear()} Bombay – Indische Spezialitäten, Freising</p>
      <ul class="flex gap-6" role="list">
        <li><a href={pfad('/impressum')} class="fuss-link">Impressum</a></li>
        <li><a href={pfad('/datenschutz')} class="fuss-link">Datenschutz</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  /* Schmale Bildschirme: Zeile zweizeilig gestapelt, ohne verwaisten Punkt am Zeilenende */
  @media (width < 28rem) {
    .feinsatz > span {
      display: block;
    }
    .feinsatz > .fuss-punkt {
      display: none;
    }
  }
  .fuss-linie {
    display: block;
    width: min(18rem, 60vw);
    height: 14px;
    background: var(--color-rani-hell);
    opacity: 0.7;
    -webkit-mask: url('/ornament/band.svg') repeat-x center / auto 100%;
    mask: url('/ornament/band.svg') repeat-x center / auto 100%;
  }
  .fuss-link {
    color: var(--color-creme);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--color-creme) 35%, transparent);
    transition: text-decoration-color 0.25s var(--ease-glut);
  }
  .fuss-link:hover {
    text-decoration-color: var(--color-rani-hell);
  }
</style>
