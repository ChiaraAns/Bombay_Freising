---
/**
 * Eigene Icons für Bombay – einheitlich 24er-Raster, 1.6er Strich.
 * Chili, Blatt und Stern sind gefüllte Formen (Kennzeichnungen), alles andere Linien.
 */
export type IconName =
  | 'telefon'
  | 'tasche'
  | 'karte'
  | 'ort'
  | 'uhr'
  | 'brief'
  | 'pfeil'
  | 'pfeil-links'
  | 'extern'
  | 'chili'
  | 'blatt'
  | 'blatt-kontur'
  | 'stern'
  | 'app'
  | 'lupe'
  | 'kreuz'
  | 'menue'
  | 'drucker'
  | 'nochmal';

interface Props {
  name: IconName;
  class?: string;
  size?: number;
  label?: string;
}

const { name, class: klasse = '', size = 20, label } = Astro.props;
const gefuellt = name === 'chili' || name === 'blatt' || name === 'stern';
---

<svg
  class={klasse}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={gefuellt ? 'currentColor' : 'none'}
  stroke={gefuellt ? 'none' : 'currentColor'}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
>
  {name === 'telefon' && (
    <path d="M6.6 3.8h2.6l1.4 4-2 1.4a11 11 0 0 0 6.2 6.2l1.4-2 4 1.4v2.6a2 2 0 0 1-2.2 2A16.4 16.4 0 0 1 4.6 6a2 2 0 0 1 2-2.2z" />
  )}
  {name === 'tasche' && (
    <>
      <path d="M5 8.5h14l-1.1 11.1a1.6 1.6 0 0 1-1.6 1.4H7.7a1.6 1.6 0 0 1-1.6-1.4z" />
      <path d="M9 10.5V7a3 3 0 0 1 6 0v3.5" />
    </>
  )}
  {name === 'karte' && (
    <>
      <path d="M4.5 5.2c2.6-.9 5-.6 7.5 1v13.6c-2.5-1.6-4.9-1.9-7.5-1z" />
      <path d="M19.5 5.2c-2.6-.9-5-.6-7.5 1v13.6c2.5-1.6 4.9-1.9 7.5-1z" />
    </>
  )}
  {name === 'ort' && (
    <>
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" />
      <circle cx="12" cy="10" r="2.3" />
    </>
  )}
  {name === 'uhr' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3 2" />
    </>
  )}
  {name === 'brief' && (
    <>
      <rect x="3.5" y="5.5" width="17" height="13" rx="1.5" />
      <path d="m4.5 7 7.5 6 7.5-6" />
    </>
  )}
  {name === 'pfeil' && <path d="M5 12h13.5M13 6.5l5.5 5.5-5.5 5.5" />}
  {name === 'pfeil-links' && <path d="M19 12H5.5M11 6.5 5.5 12l5.5 5.5" />}
  {name === 'extern' && (
    <>
      <path d="M13.5 5.5h5v5M18.5 5.5 11 13" />
      <path d="M17 14v4.2a1.3 1.3 0 0 1-1.3 1.3H5.8a1.3 1.3 0 0 1-1.3-1.3V8.3A1.3 1.3 0 0 1 5.8 7H10" />
    </>
  )}
  {name === 'chili' && (
    <>
      <path d="M16.2 7.1c2.4.5 3.7 2.6 3.2 5.1-.7 3.5-4.3 6.9-9.4 8.5-2.3.7-4.7.9-6.3.5-.5-.1-.5-.7 0-.9 3.3-1.4 5.8-3.6 7.2-6.4 1-2 1.4-3.9 2-5.3.6-1.3 1.8-1.8 3.3-1.5z" />
      <path d="M15.4 7.4c-.3-1.9.4-3.6 2.1-4.6l.8.9c-1.3.8-1.8 2-1.6 3.6zM13.6 8c1.3-1.3 3.4-1.7 5.2-.8l-.4.9c-1.4-.6-3-.4-4.1.6z" />
    </>
  )}
  {name === 'blatt' && (
    <path d="M4.6 19.4c-.6-7.7 4.5-13.5 14.9-14.8.9 9.5-4.4 15.3-13.2 15.2l-.4-.2 6.2-6.7-.6-.6-6.3 6.6z" />
  )}
  {name === 'blatt-kontur' && (
    <>
      <path d="M5 19.2C4.4 11.7 9.4 6 19.5 4.7c.9 9.3-4.3 14.9-12.9 14.8" />
      <path d="M5 19.2 12.4 12" />
    </>
  )}
  {name === 'stern' && (
    <path d="m12 2.8 2 4.4 4.5-1.7-1.7 4.5 4.4 2-4.4 2 1.7 4.5-4.5-1.7-2 4.4-2-4.4-4.5 1.7 1.7-4.5-4.4-2 4.4-2-1.7-4.5 4.5 1.7z" />
  )}
  {name === 'app' && (
    <>
      <rect x="6.5" y="2.8" width="11" height="18.4" rx="2.2" />
      <path d="M10.5 18h3" />
    </>
  )}
  {name === 'lupe' && (
    <>
      <circle cx="10.5" cy="10.5" r="6" />
      <path d="m15 15 5 5" />
    </>
  )}
  {name === 'kreuz' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'menue' && <path d="M4 7.5h16M4 12h16M4 16.5h10" />}
  {name === 'drucker' && (
    <>
      <path d="M7 9V3.8h10V9" />
      <rect x="3.8" y="9" width="16.4" height="7.5" rx="1.5" />
      <path d="M7 14h10v6.2H7z" />
    </>
  )}
  {name === 'nochmal' && (
    <>
      <path d="M4.5 12a7.5 7.5 0 1 0 2.2-5.3" />
      <path d="M4.5 4.5v4h4" />
    </>
  )}
</svg>
