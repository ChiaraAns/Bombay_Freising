---
/**
 * Online-Bestellung: Auswahl → Angaben → Fertig.
 * Daten aus src/data/speisekarte.ts, Einstellungen in src/data/bestellung.ts.
 */
import Basis from '../layouts/Basis.astro';
import Icon from '../components/Icon.astro';
import Kennzeichen from '../components/Kennzeichen.astro';
import { speisekarte, preisFormat } from '../data/speisekarte';
import { bestellung } from '../data/bestellung';
import { kontakt } from '../data/kontakt';
import { pfad } from '../lib/pfad';

const lieferung = bestellung.lieferung;
---

<Basis
  titel="Online bestellen – Bombay, indisches Restaurant in Freising"
  beschreibung="Indisch bestellen in Freising: Gerichte auswählen, Lieferung oder Abholung wählen, Wunschzeit angeben – direkt beim Bombay in der Oberen Hauptstraße."
  aktiv="bestellen"
  ohneReibeflaeche
>
  <div class="bestellseite pb-28 text-creme lg:pb-0" data-bestellseite data-endpunkt={bestellung.endpunkt ?? ''} data-email={kontakt.email}>
    <header class="koernung bg-tinte pb-10 pt-10 text-creme md:pb-12 md:pt-14">
      <div class="rahmen">
        <h1 class="display-xl">Online bestellen</h1>
        <p class="mt-4 max-w-[36rem] text-lead leading-relaxed text-rauch" data-erscheinen>
          Stellen Sie Ihre Bestellung zusammen – {lieferung.aktiv ? 'zur Lieferung oder zur Abholung' : 'zur Abholung'} bei uns
          in der Freisinger Altstadt.
        </p>
        <ol class="schritte mt-8 flex flex-wrap gap-x-6 gap-y-2 text-fein" aria-label="Schritte">
          <li data-schritt-anzeige="auswahl" aria-current="step"><span class="schritt-nr">1</span> Auswahl</li>
          <li data-schritt-anzeige="kasse"><span class="schritt-nr">2</span> Ihre Angaben</li>
          <li data-schritt-anzeige="fertig"><span class="schritt-nr">3</span> Fertig</li>
        </ol>
      </div>
    </header>

    <!-- ===== Schritt 1: Auswahl ===== -->
    <div data-ansicht="auswahl">
      <nav class="kat-leiste sticky top-0 z-30" aria-label="Kategorien">
        <ul class="kat-liste rahmen" role="list">
          {speisekarte.map((k) => <li><a href={`#b-${k.id}`} class="kat-link">{k.kurz}</a></li>)}
        </ul>
      </nav>

      <div class="blatt">
      <div class="rahmen grid gap-10 pb-12 pt-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-12">
        <div>
          {
            speisekarte.map((k) => (
              <section id={`b-${k.id}`} class="kategorie" aria-labelledby={`bt-${k.id}`}>
                <h2 id={`bt-${k.id}`} class="display-m">{k.titel}</h2>
                {k.hinweis && <p class="mt-2 max-w-[44rem] text-fein text-braun">{k.hinweis}</p>}
                <ul class="mt-4" role="list">
                  {k.gerichte.map((g) => {
                    const id = g.nr ? String(g.nr) : g.name;
                    const varianten = g.preisZusatz === 'je' && g.beschreibung ? g.beschreibung.split(/,\s*/) : null;
                    return (
                      <li class="artikel" data-artikel={id}>
                        <span class:list={['artikel-nr tabellenziffern', !g.nr && 'leer']} aria-hidden="true">{g.nr ?? ''}</span>
                        <div class="min-w-0">
                          <h3 class="artikel-name">{g.name}</h3>
                          {g.beschreibung && !varianten && <p class="artikel-text">{g.beschreibung}</p>}
                          {varianten && (
                            <label class="mt-1.5 block text-fein text-braun">
                              <span class="sr-only">Sorte für {g.name}</span>
                              <select class="variante" data-variante>
                                {varianten.map((v) => <option value={v}>{v}</option>)}
                              </select>
                            </label>
                          )}
                          <Kennzeichen gericht={g} kompakt class="mt-1.5" />
                        </div>
                        <div class="artikel-rechts">
                          <p class="artikel-preis tabellenziffern">{preisFormat(g.preis)}</p>
                          <div class="mengen" data-mengen>
                            <button type="button" class="hinzu" data-hinzu aria-label={`${g.name} hinzufügen`}>
                              <span aria-hidden="true">+</span>
                            </button>
                          </div>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </section>
            ))
          }
          <p class="mt-12 flex gap-3 border-t border-tinte/15 pt-6 text-fein text-braun">
            <Icon name="info" size={20} class="mt-0.5 shrink-0 text-braun" />
            Informationen zu Allergenen erhalten Sie bei unserem Personal unter {kontakt.telefonAnzeige}.
          </p>
        </div>

        <!-- Warenkorb (Desktop: mitlaufend) -->
        <aside class="hidden lg:block" aria-label="Warenkorb">
          <div class="warenkorb sticky top-20">
            <h2 class="font-display text-zwischen">Ihr Warenkorb</h2>
            <div class="mt-4" data-warenkorb-liste></div>
            <button type="button" class="knopf knopf-glut mt-5 w-full" data-zur-kasse disabled>
              Weiter zu Ihren Angaben <Icon name="pfeil" size={18} />
            </button>
          </div>
        </aside>
      </div>
      </div>

      <!-- Warenkorb-Leiste (Handy) -->
      <div class="korb-leiste fixed inset-x-0 bottom-0 z-40 pb-[env(safe-area-inset-bottom)] lg:hidden" data-korb-leiste hidden>
        <button type="button" class="korb-leiste-knopf" data-zur-kasse>
          <span class="flex items-center gap-2.5">
            <Icon name="tasche" size={20} />
            <span data-korb-anzahl>0 Artikel</span>
          </span>
          <span class="flex items-center gap-2 font-semibold">
            <span class="tabellenziffern" data-korb-summe>0,00 €</span>
            Weiter <Icon name="pfeil" size={18} />
          </span>
        </button>
      </div>
    </div>

    <!-- ===== Schritt 2: Angaben ===== -->
    <div data-ansicht="kasse" hidden>
      <div class="blatt">
      <div class="rahmen grid gap-10 py-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-12 lg:py-14">
        <form class="kasse min-w-0" novalidate data-formular>
          <button type="button" class="zurueck" data-zurueck-auswahl>
            <Icon name="pfeil-links" size={17} /> Zurück zur Auswahl
          </button>
          <h2 class="display-l mt-4" tabindex="-1" data-kasse-titel>Ihre Angaben</h2>

          <fieldset class="mt-8">
            <legend class="feld-titel">Wie möchten Sie Ihr Essen bekommen?</legend>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
              {
                lieferung.aktiv && (
                  <label class="art-karte">
                    <input type="radio" name="art" value="lieferung" checked />
                    <span class="art-titel">
                      <Icon name="tasche" size={20} /> Lieferung
                    </span>
                    <span class="art-text">{lieferung.gebiet ? `Liefergebiet: ${lieferung.gebiet}` : 'Wir bringen es zu Ihnen.'}</span>
                  </label>
                )
              }
              <label class="art-karte">
                <input type="radio" name="art" value="abholung" checked={!lieferung.aktiv} />
                <span class="art-titel">
                  <Icon name="ort" size={20} /> Abholung
                </span>
                <span class="art-text">{kontakt.strasse}, {kontakt.ort}</span>
              </label>
            </div>
          </fieldset>

          <div class="mt-8">
            <label for="zeit" class="feld-titel">Wunschzeit</label>
            <select id="zeit" name="zeit" class="feld mt-2" required data-zeit></select>
            <p class="feld-fehler" id="zeit-fehler" hidden></p>
          </div>

          <div class="mt-8 grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="feld-titel">Name</label>
              <input id="name" name="name" class="feld mt-2" autocomplete="name" required aria-describedby="name-fehler" />
              <p class="feld-fehler" id="name-fehler" hidden></p>
            </div>
            <div>
              <label for="telefon" class="feld-titel">Telefon <span class="feld-hinweis">für Rückfragen</span></label>
              <input id="telefon" name="telefon" type="tel" class="feld mt-2" autocomplete="tel" required inputmode="tel" aria-describedby="telefon-fehler" />
              <p class="feld-fehler" id="telefon-fehler" hidden></p>
            </div>
            <div class="sm:col-span-2">
              <label for="email" class="feld-titel">E-Mail <span class="feld-hinweis">optional</span></label>
              <input id="email" name="email" type="email" class="feld mt-2" autocomplete="email" aria-describedby="email-fehler" />
              <p class="feld-fehler" id="email-fehler" hidden></p>
            </div>
          </div>

          <fieldset class="adresse mt-8 grid gap-5 sm:grid-cols-[1fr_8rem_1fr]" data-adresse>
            <legend class="feld-titel mb-3">Lieferadresse</legend>
            <div class="sm:col-span-3">
              <label for="strasse" class="sr-only">Straße und Hausnummer</label>
              <input id="strasse" name="strasse" class="feld" placeholder="Straße und Hausnummer" autocomplete="street-address" aria-describedby="strasse-fehler" />
              <p class="feld-fehler" id="strasse-fehler" hidden></p>
            </div>
            <div>
              <label for="plz" class="sr-only">Postleitzahl</label>
              <input id="plz" name="plz" class="feld" placeholder="PLZ" inputmode="numeric" autocomplete="postal-code" maxlength="5" aria-describedby="plz-fehler" />
              <p class="feld-fehler" id="plz-fehler" hidden></p>
            </div>
            <div class="sm:col-span-2">
              <label for="ort" class="sr-only">Ort</label>
              <input id="ort" name="ort" class="feld" placeholder="Ort" value="Freising" autocomplete="address-level2" aria-describedby="ort-fehler" />
              <p class="feld-fehler" id="ort-fehler" hidden></p>
            </div>
          </fieldset>

          <div class="mt-8">
            <label for="anmerkung" class="feld-titel">Anmerkungen <span class="feld-hinweis">optional</span></label>
            <textarea id="anmerkung" name="anmerkung" rows="3" class="feld mt-2" placeholder="z. B. Allergien, Klingelname, Hinweise zur Abholung"></textarea>
          </div>

          <label class="einwilligung mt-8">
            <input type="checkbox" name="datenschutz" required aria-describedby="datenschutz-fehler" />
            <span>
              Ich bin einverstanden, dass meine Angaben zur Bearbeitung der Bestellung verwendet werden. Mehr in der{' '}
              <a href={pfad('/datenschutz')} class="underline">Datenschutzerklärung</a>.
            </span>
          </label>
          <p class="feld-fehler" id="datenschutz-fehler" hidden></p>

          {bestellung.zahlungshinweis && <p class="mt-6 text-fein text-braun">{bestellung.zahlungshinweis}</p>}

          <p class="feld-fehler mt-6" data-mindest-fehler hidden></p>

          <button type="submit" class="knopf knopf-glut mt-8 w-full whitespace-normal sm:w-auto sm:px-10" data-absenden>
            Zahlungspflichtig bestellen
          </button>
          {
            !bestellung.endpunkt && (
              <p class="mt-4 max-w-[36rem] text-fein text-braun">
                Mit dem Klick öffnet sich Ihr E-Mail-Programm mit der fertigen Bestellung an {kontakt.email}. Bitte senden Sie
                die E-Mail dort ab – erst dann ist die Bestellung beim Restaurant.
              </p>
            )
          }
        </form>

        <aside aria-label="Ihre Bestellung">
          <div class="warenkorb lg:sticky lg:top-8">
            <h2 class="font-display text-zwischen">Ihre Bestellung</h2>
            <div class="mt-4" data-warenkorb-liste></div>
          </div>
        </aside>
      </div>
      </div>
    </div>

    <!-- ===== Schritt 3: Fertig ===== -->
    <div data-ansicht="fertig" hidden>
      <div class="blatt">
      <div class="rahmen py-14 md:py-20">
        <div class="fertig mx-auto max-w-[40rem]">
          <span class="fertig-ornament" aria-hidden="true"></span>
          <h2 class="display-l mt-6" tabindex="-1" data-fertig-titel>Fast geschafft</h2>
          <p class="mt-4 text-lead leading-relaxed text-braun" data-fertig-text></p>
          <p class="mt-6 font-semibold">Bestellnummer: <span class="tabellenziffern" data-fertig-nummer></span></p>
          <pre class="bestelltext mt-4" data-fertig-bestelltext></pre>
          <div class="mt-6 flex flex-wrap gap-3" data-fertig-aktionen>
            <a class="knopf knopf-glut" data-mail-erneut href="#">E-Mail erneut öffnen</a>
            <button type="button" class="knopf knopf-kontur" data-kopieren>Bestelltext kopieren</button>
          </div>
          <p class="mt-8 text-braun">
            Lieber telefonisch? <a href={kontakt.telefonLink} class="tabellenziffern font-semibold text-glut underline">{kontakt.telefonAnzeige}</a>
          </p>
          <a href={pfad('/')} class="zurueck mt-10">
            <Icon name="pfeil-links" size={17} /> Zur Startseite
          </a>
        </div>
      </div>
      </div>
    </div>
  </div>
</Basis>

<script>
  import {
    artikel,
    findeArtikel,
    schluessel,
    zwischensumme,
    gesamt,
    anzahl,
    preis,
    zeitoptionen,
    bestellnummer,
    bestelltext,
    type Position,
    type Zeitoption,
  } from '../lib/warenkorb';
  import { ladeKorb, speichereKorb } from '../lib/korb-speicher';
  import { bestellung } from '../data/bestellung';

  const seite = document.querySelector<HTMLElement>('[data-bestellseite]')!;
  // Gemeinsamer Warenkorb mit der Speisekarte (localStorage)
  let korb: Position[] = ladeKorb();
  const speichern = () => speichereKorb(korb);

  // Aus dem Curry-Kompass: ?add=75,158
  const neu = new URLSearchParams(location.search).get('add');
  if (neu) {
    for (const id of neu.split(',')) if (findeArtikel(id)) aendere({ id }, +1, false);
    history.replaceState(null, '', location.pathname);
  }

  function menge(p: Pick<Position, 'id' | 'variante'>) {
    return korb.find((x) => schluessel(x) === schluessel(p))?.menge ?? 0;
  }

  function aendere(p: Pick<Position, 'id' | 'variante'>, delta: number, zeichnen = true) {
    const k = schluessel(p);
    const vorhanden = korb.find((x) => schluessel(x) === k);
    if (vorhanden) vorhanden.menge = Math.max(0, Math.min(99, vorhanden.menge + delta));
    else if (delta > 0) korb.push({ id: p.id, variante: p.variante, menge: delta });
    korb = korb.filter((x) => x.menge > 0);
    speichern();
    if (zeichnen) zeichne();
  }

  // ---------- Darstellung ----------
  const stepperHtml = (name: string, n: number) => `
    <button type="button" class="stepper-knopf" data-minus aria-label="${name}: eins weniger">−</button>
    <span class="stepper-zahl tabellenziffern" aria-live="polite" aria-label="${n} im Warenkorb">${n}</span>
    <button type="button" class="stepper-knopf" data-plus aria-label="${name}: eins mehr">+</button>`;

  function zeichneArtikel() {
    document.querySelectorAll<HTMLElement>('[data-artikel]').forEach((li) => {
      const id = li.dataset.artikel!;
      const a = findeArtikel(id)!;
      const variante = li.querySelector<HTMLSelectElement>('[data-variante]')?.value;
      const n = a.varianten ? korb.filter((x) => x.id === id).reduce((s, x) => s + x.menge, 0) : menge({ id });
      const box = li.querySelector<HTMLElement>('[data-mengen]')!;
      li.classList.toggle('im-korb', n > 0);
      if (n > 0 && !a.varianten) {
        if (!box.querySelector('[data-plus]')) box.innerHTML = stepperHtml(a.name, n);
        else box.querySelector('.stepper-zahl')!.textContent = String(n);
      } else if (!box.querySelector('[data-hinzu]')) {
        box.innerHTML = `<button type="button" class="hinzu" data-hinzu aria-label="${a.name} hinzufügen"><span aria-hidden="true">+</span></button>`;
      }
      if (a.varianten) {
        const badge = n > 0 ? `<span class="varianten-zahl tabellenziffern" aria-label="${n} im Warenkorb">${n}</span>` : '';
        box.querySelector('.varianten-zahl')?.remove();
        if (badge) box.insertAdjacentHTML('afterbegin', badge);
      }
    });
  }

  function zeichneKorb() {
    const art = (document.querySelector<HTMLInputElement>('input[name="art"]:checked')?.value ?? 'abholung') as
      | 'lieferung'
      | 'abholung';
    const html = korb.length
      ? `<ul class="korb-liste" role="list">${korb
          .map((p) => {
            const a = findeArtikel(p.id)!;
            const name = `${a.name}${p.variante ? ` <span class="korb-variante">(${p.variante})</span>` : ''}`;
            return `<li class="korb-zeile" data-korb-position="${schluessel(p)}">
              <div class="min-w-0"><p class="korb-name">${a.nr ? `<span class="korb-nr tabellenziffern">${a.nr}</span>` : ''}${name}</p>
              <div class="korb-stepper">${stepperHtml(a.name, p.menge)}</div></div>
              <p class="korb-preis tabellenziffern">${preis(a.preis * p.menge)}</p></li>`;
          })
          .join('')}</ul>
          <dl class="korb-summe tabellenziffern">${
            art === 'lieferung' && bestellung.lieferung.gebuehr != null
              ? `<div><dt>Zwischensumme</dt><dd>${preis(zwischensumme(korb))}</dd></div>
                <div><dt>Liefergebühr</dt><dd>${bestellung.lieferung.gebuehr ? preis(bestellung.lieferung.gebuehr) : 'kostenlos'}</dd></div>
                <div class="korb-gesamt"><dt>Gesamt</dt><dd>${preis(gesamt(korb, art))}</dd></div>`
              : `<div class="korb-gesamt"><dt>Summe</dt><dd>${preis(zwischensumme(korb))}</dd></div>`
          }</dl>${
            // Liefergebühr unbekannt (TODO in bestellung.ts): keinen Endpreis behaupten
            art === 'lieferung' && bestellung.lieferung.gebuehr == null
              ? `<p class="korb-hinweis">Eine eventuelle Liefergebühr ist hier nicht enthalten.</p>`
              : ''
          }`
      : `<p class="korb-leer">Noch nichts ausgewählt. Tippen Sie bei einem Gericht auf „+“.</p>`;
    document.querySelectorAll<HTMLElement>('[data-warenkorb-liste]').forEach((el) => (el.innerHTML = html));
    document.querySelectorAll<HTMLButtonElement>('[data-zur-kasse]').forEach((b) => (b.disabled = !korb.length));
    const leiste = document.querySelector<HTMLElement>('[data-korb-leiste]')!;
    leiste.hidden = !korb.length || aktuelleAnsicht !== 'auswahl';
    const n = anzahl(korb);
    document.querySelector('[data-korb-anzahl]')!.textContent = `${n} ${n === 1 ? 'Artikel' : 'Artikel'}`;
    document.querySelector('[data-korb-summe]')!.textContent = preis(zwischensumme(korb));
  }

  function zeichne() {
    zeichneArtikel();
    zeichneKorb();
  }

  // Klicks: Hinzufügen, Plus/Minus (Artikelliste und Warenkorb)
  seite.addEventListener('click', (e) => {
    const ziel = e.target as HTMLElement;
    const knopf = ziel.closest<HTMLButtonElement>('[data-hinzu], [data-plus], [data-minus]');
    if (!knopf) return;
    const delta = knopf.matches('[data-minus]') ? -1 : 1;
    const zeile = knopf.closest<HTMLElement>('[data-korb-position]');
    if (zeile) {
      const [id, variante] = zeile.dataset.korbPosition!.split('|');
      aendere({ id, variante }, delta);
      return;
    }
    const li = knopf.closest<HTMLElement>('[data-artikel]')!;
    const id = li.dataset.artikel!;
    const variante = li.querySelector<HTMLSelectElement>('[data-variante]')?.value;
    aendere({ id, variante }, delta);
    if (knopf.matches('[data-hinzu]') && !findeArtikel(id)!.varianten) li.querySelector<HTMLButtonElement>('[data-plus]')?.focus();
  });

  // ---------- Ansichten ----------
  type Ansicht = 'auswahl' | 'kasse' | 'fertig';
  let aktuelleAnsicht: Ansicht = 'auswahl';
  function zeige(ansicht: Ansicht, verlauf = true) {
    aktuelleAnsicht = ansicht;
    document.querySelectorAll<HTMLElement>('[data-ansicht]').forEach((el) => (el.hidden = el.dataset.ansicht !== ansicht));
    document.querySelectorAll<HTMLElement>('[data-schritt-anzeige]').forEach((li) => {
      li.toggleAttribute('aria-current', li.dataset.schrittAnzeige === ansicht);
      if (li.dataset.schrittAnzeige === ansicht) li.setAttribute('aria-current', 'step');
    });
    if (verlauf) history.pushState({ ansicht }, '', ansicht === 'auswahl' ? location.pathname : `#${ansicht}`);
    window.scrollTo({ top: 0 });
    if (ansicht === 'kasse') {
      fuelleZeiten();
      document.querySelector<HTMLElement>('[data-kasse-titel]')?.focus();
    }
    if (ansicht === 'fertig') document.querySelector<HTMLElement>('[data-fertig-titel]')?.focus();
    zeichneKorb();
  }
  window.addEventListener('popstate', (e) => zeige((e.state?.ansicht as Ansicht) ?? 'auswahl', false));
  document.querySelectorAll('[data-zur-kasse]').forEach((b) => b.addEventListener('click', () => korb.length && zeige('kasse')));
  document.querySelector('[data-zurueck-auswahl]')!.addEventListener('click', () => zeige('auswahl'));

  // ---------- Formular ----------
  const form = document.querySelector<HTMLFormElement>('[data-formular]')!;
  const zeitSelect = document.querySelector<HTMLSelectElement>('[data-zeit]')!;
  let zeiten: Zeitoption[] = [];

  function fuelleZeiten() {
    const gewaehlt = zeitSelect.value;
    zeiten = zeitoptionen(new Date());
    zeitSelect.innerHTML = '';
    if (!zeiten.length) {
      zeitSelect.innerHTML = '<option value="">Derzeit keine Zeiten verfügbar</option>';
      return;
    }
    const gruppen = new Map<string, HTMLOptGroupElement>();
    for (const z of zeiten) {
      if (!gruppen.has(z.gruppe)) {
        const g = document.createElement('optgroup');
        g.label = z.gruppe;
        gruppen.set(z.gruppe, g);
        zeitSelect.append(g);
      }
      gruppen.get(z.gruppe)!.append(new Option(z.label, z.wert));
    }
    if (gewaehlt && zeiten.some((z) => z.wert === gewaehlt)) zeitSelect.value = gewaehlt;
  }

  const adresse = document.querySelector<HTMLElement>('[data-adresse]')!;
  const aktualisiereArt = () => {
    const art = form.querySelector<HTMLInputElement>('input[name="art"]:checked')?.value;
    adresse.hidden = art !== 'lieferung';
    zeichneKorb();
  };
  form.querySelectorAll('input[name="art"]').forEach((r) => r.addEventListener('change', aktualisiereArt));
  aktualisiereArt();

  function fehler(id: string, text: string | null) {
    const p = document.getElementById(`${id}-fehler`);
    const feld = form.querySelector<HTMLElement>(`[name="${id}"]`);
    if (p) {
      p.hidden = !text;
      p.textContent = text ?? '';
    }
    feld?.setAttribute('aria-invalid', text ? 'true' : 'false');
    return !text;
  }

  // Fehlermeldung verschwindet, sobald das Feld bearbeitet wird
  form.addEventListener('input', (e) => {
    const feld = e.target as HTMLInputElement;
    if (feld.name && feld.getAttribute('aria-invalid') === 'true') fehler(feld.name, null);
  });
  form.addEventListener('change', (e) => {
    const feld = e.target as HTMLInputElement;
    if (feld.name && feld.getAttribute('aria-invalid') === 'true') fehler(feld.name, null);
  });

  let letzteMail = '';
  let letzterText = '';

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const art = d.get('art') as 'lieferung' | 'abholung';
    const wert = (n: string) => String(d.get(n) ?? '').trim();
    const ok = [
      fehler('zeit', zeitSelect.value ? null : 'Bitte wählen Sie eine Wunschzeit.'),
      fehler('name', wert('name').length >= 2 ? null : 'Bitte geben Sie Ihren Namen an.'),
      fehler('telefon', /^[+\d][\d\s/()-]{5,}$/.test(wert('telefon')) ? null : 'Bitte geben Sie eine Telefonnummer für Rückfragen an.'),
      fehler('email', !wert('email') || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(wert('email')) ? null : 'Diese E-Mail-Adresse sieht unvollständig aus.'),
      ...(art === 'lieferung'
        ? [
            fehler('strasse', wert('strasse').length >= 4 ? null : 'Bitte Straße und Hausnummer angeben.'),
            fehler('plz', /^\d{5}$/.test(wert('plz')) ? null : 'Bitte eine fünfstellige Postleitzahl angeben.'),
            fehler('ort', wert('ort').length >= 2 ? null : 'Bitte den Ort angeben.'),
          ]
        : []),
      fehler('datenschutz', d.get('datenschutz') ? null : 'Bitte bestätigen Sie die Verwendung Ihrer Angaben.'),
    ].every(Boolean);

    const mindest = bestellung.lieferung.mindestbestellwert;
    const mindestFehler = document.querySelector<HTMLElement>('[data-mindest-fehler]')!;
    const unterMindest = art === 'lieferung' && mindest != null && zwischensumme(korb) < mindest;
    mindestFehler.hidden = !unterMindest;
    mindestFehler.textContent = unterMindest ? `Für Lieferungen gilt ein Mindestbestellwert von ${preis(mindest!)}.` : '';

    if (!ok || unterMindest || !korb.length) {
      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      return;
    }

    const b = {
      nummer: bestellnummer(),
      art,
      zeit: zeiten.find((z) => z.wert === zeitSelect.value)!,
      kunde: {
        name: wert('name'),
        telefon: wert('telefon'),
        email: wert('email') || undefined,
        strasse: wert('strasse'),
        plz: wert('plz'),
        ort: wert('ort'),
      },
      positionen: korb.map((p) => ({ ...p })),
      anmerkung: wert('anmerkung') || undefined,
    };
    letzterText = bestelltext(b);
    const titel = document.querySelector<HTMLElement>('[data-fertig-titel]')!;
    const text = document.querySelector<HTMLElement>('[data-fertig-text]')!;
    document.querySelector('[data-fertig-nummer]')!.textContent = b.nummer;
    document.querySelector('[data-fertig-bestelltext]')!.textContent = letzterText;
    const absenden = form.querySelector<HTMLButtonElement>('[data-absenden]')!;

    const endpunkt = seite.dataset.endpunkt;
    if (endpunkt) {
      absenden.disabled = true;
      absenden.textContent = 'Wird gesendet …';
      try {
        const antwort = await fetch(endpunkt, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ ...b, text: letzterText, summe: gesamt(b.positionen, b.art) }),
        });
        if (!antwort.ok) throw new Error(String(antwort.status));
        titel.textContent = 'Danke für Ihre Bestellung!';
        text.textContent = 'Ihre Bestellung ist beim Restaurant eingegangen. Bei Rückfragen melden wir uns telefonisch.';
        document.querySelector<HTMLElement>('[data-fertig-aktionen]')!.hidden = true;
        korb = [];
        speichern();
        zeige('fertig');
      } catch {
        mindestFehler.hidden = false;
        mindestFehler.textContent =
          'Die Bestellung konnte gerade nicht gesendet werden. Bitte versuchen Sie es erneut oder bestellen Sie telefonisch.';
      } finally {
        absenden.disabled = false;
        absenden.textContent = 'Zahlungspflichtig bestellen';
      }
      return;
    }

    // Ohne Server: fertige E-Mail an das Restaurant öffnen
    const betreff = `Bestellung ${b.nummer} – ${art === 'lieferung' ? 'Lieferung' : 'Abholung'} – ${b.zeit.label}`;
    letzteMail = `mailto:${seite.dataset.email}?subject=${encodeURIComponent(betreff)}&body=${encodeURIComponent(letzterText)}`;
    document.querySelector<HTMLAnchorElement>('[data-mail-erneut]')!.href = letzteMail;
    titel.textContent = 'Fast geschafft';
    const adresse = Object.assign(document.createElement('a'), { href: `mailto:${seite.dataset.email}`, textContent: seite.dataset.email });
    adresse.className = 'fertig-adresse';
    text.replaceChildren(
      'Ihr E-Mail-Programm hat sich mit der fertigen Bestellung geöffnet. Bitte senden Sie die E-Mail ab – erst dann ist Ihre Bestellung beim Restaurant. Falls sich nichts geöffnet hat, kopieren Sie den Bestelltext und schicken ihn an ',
      adresse,
      '.',
    );
    zeige('fertig');
    window.location.href = letzteMail;
  });

  document.querySelector('[data-kopieren]')!.addEventListener('click', async (e) => {
    const knopf = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(letzterText);
      knopf.textContent = 'Kopiert';
    } catch {
      knopf.textContent = 'Bitte Text markieren und kopieren';
    }
  });

  // Start
  zeichne();
  if (location.hash === '#kasse' && korb.length) zeige('kasse', false);
  else if (location.hash) history.replaceState(null, '', location.pathname);
</script>

