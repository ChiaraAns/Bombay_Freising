---
import Basis from './Basis.astro';

interface Props {
  titel: string;
  beschreibung: string;
}
const { titel, beschreibung } = Astro.props;
// TODO: `noindex` unten entfernen, sobald Impressum und Datenschutz vollständig ausgefüllt sind.
---

<Basis titel={`${titel} – Bombay Freising`} beschreibung={beschreibung} aktiv="recht" noindex>
  <div class="pt-6 text-creme md:pt-10">
    <div class="blatt">
    <div class="rahmen py-16 md:py-24">
      <article class="rechtstext mx-auto max-w-[46rem]">
        <span class="bordure w-40" aria-hidden="true"></span>
        <h1 class="display-l mt-6">{titel}</h1>
        <slot />
      </article>
    </div>
    </div>
  </div>
</Basis>

<style>
  .rechtstext :global(h2) {
    margin-top: 2.25rem;
    font-size: var(--text-zwischen);
  }
  .rechtstext :global(p),
  .rechtstext :global(ul),
  .rechtstext :global(address) {
    margin-top: 0.75rem;
    font-style: normal;
    line-height: 1.65;
  }
  .rechtstext :global(ul) {
    padding-left: 1.2rem;
    list-style: disc;
  }
  .rechtstext :global(a) {
    color: var(--color-glut);
    text-decoration: underline;
  }
  .rechtstext :global(.todo) {
    display: block;
    margin-top: 0.75rem;
    padding: 0.7rem 0.9rem;
    background: var(--color-hinweis-grund);
    border: 1px dashed var(--color-kurkuma);
    color: var(--color-hinweis-text);
    font-size: var(--text-fein);
  }
</style>
