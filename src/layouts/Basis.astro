---
import { pfad, BASIS } from '../lib/pfad';
import '../styles/global.css';
import Kopf from '../components/Kopf.astro';
import Fuss from '../components/Fuss.astro';
import Reibeflaeche from '../components/Reibeflaeche.astro';
import { kontakt } from '../data/kontakt';
import { oeffnungszeiten } from '../data/oeffnungszeiten';

interface Props {
  titel: string;
  beschreibung: string;
  /** JSON-LD nur auf der Startseite ausgeben */
  strukturierteDaten?: boolean;
  aktiv?: 'start' | 'speisekarte' | 'recht';
  /** Seiten ohne Indexierung (z. B. Rechtstexte mit Platzhaltern) */
  noindex?: boolean;
}

const { titel, beschreibung, strukturierteDaten = false, aktiv = 'start', noindex = false } = Astro.props;
// Vorschau-Build (GitHub Pages): nicht indexieren, Canonical zeigt auf die echte Domain
const vorschau = process.env.VORSCHAU === '1';
const canonical = new URL(Astro.url.pathname.replace(BASIS, '') || '/', Astro.site).href;
const ogBild = new URL('/og.jpg', Astro.site).href;

const tagCode: Record<number, string> = {
  1: 'Monday',
  2: 'Tuesday',
  3: 'Wednesday',
  4: 'Thursday',
  5: 'Friday',
  6: 'Saturday',
  7: 'Sunday',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: `${kontakt.name} – ${kontakt.zusatz}`,
  description:
    'Indisches Restaurant in der Freisinger Altstadt mit Holzkohle-Lehmofen (Tandoor), hausgemachtem Paneer, Thalis und großer vegetarischer Auswahl. Lieferservice und Abholung.',
  url: kontakt.website,
  telephone: kontakt.telefonInternational,
  email: kontakt.email,
  image: ogBild,
  servesCuisine: ['Indian', 'Indisch'],
  hasMenu: new URL('/speisekarte', Astro.site).href,
  acceptsReservations: 'True',
  address: {
    '@type': 'PostalAddress',
    streetAddress: kontakt.strasse,
    postalCode: kontakt.plz,
    addressLocality: kontakt.ort,
    addressRegion: 'Bayern',
    addressCountry: kontakt.land,
  },
  openingHoursSpecification: Object.entries(oeffnungszeiten).flatMap(([tag, fenster]) =>
    fenster.map((f) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: `https://schema.org/${tagCode[Number(tag)]}`,
      opens: f.von,
      closes: f.bis,
    })),
  ),
  potentialAction: {
    '@type': 'OrderAction',
    target: kontakt.bestellUrl,
  },
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={canonical} />
    {(noindex || vorschau) && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#1B1714" />
    <link rel="icon" href={pfad('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={pfad('/apple-touch-icon.png')} />
    <link rel="preload" href={pfad('/fonts/rozha-one-latin-400-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={pfad('/fonts/mukta-latin-400-normal.woff2')} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Bombay – Indische Spezialitäten, Freising" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogBild} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {strukturierteDaten && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-dvh pb-[calc(4.25rem+env(safe-area-inset-bottom))] md:pb-0">
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:bg-creme focus:px-4 focus:py-2 focus:text-tinte"
      >Zum Inhalt springen</a
    >
    <Kopf aktiv={aktiv} />
    <main id="inhalt" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Fuss />
    <Reibeflaeche />

    <script>
      // Dezentes Einblenden beim Scrollen (respektiert prefers-reduced-motion per CSS)
      const elemente = document.querySelectorAll<HTMLElement>('[data-erscheinen]');
      if ('IntersectionObserver' in window && elemente.length) {
        const io = new IntersectionObserver(
          (eintraege) => {
            for (const e of eintraege) {
              if (e.isIntersecting) {
                e.target.classList.add('sichtbar');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        elemente.forEach((el) => io.observe(el));
      } else {
        elemente.forEach((el) => el.classList.add('sichtbar'));
      }
    </script>
  </body>
</html>
